{
  "name": "clearance-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src -e ts,js --exec node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "seed": "node --loader ts-node/esm src/seed.ts",
    "migrate:turso": "node --loader ts-node/esm src/migrate-to-turso.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "nodemailer": "^6.10.1",
    "sqlite": "^4.1.1",
    "sqlite3": "^5.1.6"
  },
  "optionalDependencies": {
    "pdfkit": "^0.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.6",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
